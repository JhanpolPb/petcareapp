# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# Clave para firmar los tokens de sesión (cámbiala en producción por un texto largo y aleatorio)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta

# Usuario administrador que se crea automáticamente al iniciar por primera vez
ADMIN_EMAIL=admin@petcareapp.com
ADMIN_PASSWORD=Admin123*

# Base de datos:
# - Déjala vacía en tu computador: se usa PostgreSQL embebido (carpeta ./data), sin instalar nada.
# - En el servidor público pon la URL de PostgreSQL (por ejemplo, la de Neon o Render).
# DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require
